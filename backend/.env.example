# Optional API keys. Copy this file to backend/.env and fill in what you have.
# Everything works keyless via Yahoo Finance; these only add extra data.

# Finnhub — fast real-time ticks for crypto / forex / US stocks.
# Free key: https://finnhub.io
FINNHUB_API_KEY=

# FRED (St. Louis Fed) — real economic data for the Macro Dashboard
# (CPI, GDP, unemployment, Fed funds, yield curve, latest releases).
# Without it, the FRED panels show an "add key" state (nothing is simulated).
# Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
